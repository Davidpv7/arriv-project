# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app, and they are public.
# Never put the service-role key here: it belongs to Edge Functions only.

# Local dev: run `npm run db:start`, then copy "API URL" and the publishable (anon) key it prints.
# Hosted: Supabase dashboard → Project Settings → API (project in the Sydney region, ap-southeast-2).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=

# Social sign-in buttons. Turn on only after the provider is set up in Supabase
# (Authentication → Providers). Email + password always works.
EXPO_PUBLIC_AUTH_GOOGLE=false
EXPO_PUBLIC_AUTH_APPLE=false
