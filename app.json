{
  "expo": {
    "name": "Arriv",
    "slug": "arriv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "arriv",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.arriv",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.arriv",
      "adaptiveIcon": {
        "backgroundColor": "#1F2A44",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F7F0E1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2A44",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Arriv uses the camera so you can photograph documents for your private Backpack.",
          "photosPermission": "Arriv uses your photos so you can add pictures to posts, chats and your private Backpack.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F2A44"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F7F0E1",
    "extra": {
      "eas": {
        "projectId": "79024557-8fe9-43cc-8a61-3614c73283c0"
      }
    },
    "owner": "jdavid07"
  }
}
