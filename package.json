  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@hookform/resolvers": "^7.0.8",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.3",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
